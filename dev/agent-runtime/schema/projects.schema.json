{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelfOps Agent Runtime Projects",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "scan_dirs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Directories to scan for unregistered projects (used by --discover)"
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["agents"],
        "properties": {
          "agents": {
            "type": "array",
            "items": { "type": "string" }
          },
          "bundles": {
            "type": "array",
            "items": { "type": "string" }
          },
          "include": {
            "type": "array",
            "items": { "type": "string" }
          },
          "exclude": {
            "type": "array",
            "items": { "type": "string" }
          },
          "agent_overrides": {
            "type": "object",
            "description": "Per-agent overrides that replace project-level bundles/include/exclude",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "bundles": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "include": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "exclude": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
