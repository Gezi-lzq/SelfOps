{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelfOps Agent Runtime Skills",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "description": { "type": "string" },
          "materialized_path": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["owned", "local_path", "public"] },
              "path": { "type": "string" },
              "spec": { "type": "string" },
              "repo": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "bundles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "extends": {
            "type": "array",
            "items": { "type": "string" }
          },
          "skills": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
