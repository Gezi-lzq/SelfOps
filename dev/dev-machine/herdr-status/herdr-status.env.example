# Copy to ~/.config/selfops/herdr-status.env.

# Keep status local by default. Expose it through a trusted tunnel/proxy later.
HERDR_STATUS_HOST=127.0.0.1
HERDR_STATUS_PORT=8765

# Optional link shown in the dashboard header. With the herdr-web Caddy router,
# the dashboard is served at /herdr and ttyd is served under /herdr/terminal/.
HERDR_STATUS_TTYD_URL=/herdr/terminal/
HERDR_STATUS_HISTORY_URL=/herdr/history

# Optional responsive terminal URL bases. When both are set, dashboard links
# use the mobile URL if the browser viewport width is at or below this threshold.
# The service appends ttyd arg=... parameters after choosing the base URL.
# HERDR_STATUS_TTYD_DESKTOP_URL=/herdr/terminal/
# HERDR_STATUS_TTYD_MOBILE_URL=/herdr/terminal-mobile/
# HERDR_STATUS_TTYD_MOBILE_WIDTH=700
