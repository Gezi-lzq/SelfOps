[Unit]
Description=Read-only Herdr mobile status dashboard
After=network-online.target

[Service]
Type=simple
Environment=SELFOPS_ROOT=__SELFOPS_ROOT__
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/selfops/herdr-status.env
WorkingDirectory=__SELFOPS_ROOT__
ExecStart=__SELFOPS_ROOT__/dev/dev-machine/herdr-status/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

