[Unit]
Description=Magpie local model gateway
After=network.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/selfops/magpie.env
WorkingDirectory=/home/debian/magpie
ExecStart=/home/debian/.local/bin/magpie web --addr 127.0.0.1:3430 --no-open --gateway
StandardOutput=null
StandardError=journal
Restart=always
RestartSec=3
Environment=HOME=/home/debian

[Install]
WantedBy=default.target
