# Copy to ~/.config/selfops/magpie.env and chmod 600.
# This file contains secrets after installation and must not be committed.

# Fixed internal key used by magpie web. Caddy injects it only upstream.
MAGPIE_WEB_KEY=change-me-at-least-16-characters

# Browser login at /magpie-ui/. Store only the username and password hash
# consumed by Caddy; keep the plaintext password in magpie-web-login.
MAGPIE_WEB_BASIC_AUTH_USER=debian
MAGPIE_WEB_BASIC_AUTH_HASH=$2a$14$replace-with-caddy-hash-password-output

# Native Magpie Gateway Key required by Caddy for public /magpie API calls.
MAGPIE_PUBLIC_API_KEY=replace-with-magpie-gateway-key

# Public API base shown in Magpie's Gateway page.
MAGPIE_PUBLIC_URL=https://example.ngrok-free.dev/magpie
