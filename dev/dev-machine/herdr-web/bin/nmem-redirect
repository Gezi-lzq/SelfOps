#!/usr/bin/env python3
"""Redirect /nmem (via Caddy, prefix stripped) to the current nmem cloudflared quick tunnel.

The quick tunnel URL changes on restart, so instead of pinning it we read it live
from cloudflared's metrics endpoint on every request and issue a 302. This keeps the
public entry (https://<ngrok>/nmem) stable while the underlying tunnel URL rotates.
"""
from __future__ import annotations

import os
import re
import sys
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

METRICS = os.environ.get("NMEM_CLOUDFLARED_METRICS", "127.0.0.1:20250")
PORT = int(os.environ.get("NMEM_REDIRECT_PORT", "8781"))
METRICS_URL = f"http://{METRICS}/metrics"
URL_RE = re.compile(r'userHostname="(https://[a-z0-9-]+\.trycloudflare\.com)"')


def current_tunnel_url() -> str | None:
    try:
        with urllib.request.urlopen(METRICS_URL, timeout=3) as resp:
            body = resp.read().decode("utf-8", "replace")
    except Exception as exc:  # metrics unreachable -> tunnel not ready
        print(f"metrics fetch failed: {exc}", file=sys.stderr)
        return None
    matches = URL_RE.findall(body)
    return matches[-1] if matches else None


class RedirectHandler(BaseHTTPRequestHandler):
    def _redirect(self, include_body: bool) -> None:
        base = current_tunnel_url()
        if not base:
            self.send_response(503)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            if include_body:
                self.wfile.write(b"nmem tunnel not ready\n")
            return
        location = base + self.path
        self.send_response(302)
        self.send_header("Location", location)
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def do_GET(self) -> None:
        self._redirect(include_body=True)

    def do_HEAD(self) -> None:
        self._redirect(include_body=False)

    def log_message(self, fmt: str, *args) -> None:
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))


def main() -> None:
    server = ThreadingHTTPServer(("127.0.0.1", PORT), RedirectHandler)
    print(f"nmem-redirect listening on 127.0.0.1:{PORT}, metrics {METRICS_URL}", file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        server.shutdown()


if __name__ == "__main__":
    main()
