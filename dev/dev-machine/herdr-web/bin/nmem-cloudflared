#!/usr/bin/env bash
set -euo pipefail

env_file="${HERDR_WEB_ENV_FILE:-$HOME/.config/selfops/herdr-web.env}"
if [[ -f "$env_file" ]]; then
  # shellcheck disable=SC1090
  source "$env_file"
fi

port="${NMEM_CLOUDFLARED_TARGET_PORT:-14242}"
metrics="${NMEM_CLOUDFLARED_METRICS:-127.0.0.1:20250}"
target="http://127.0.0.1:${port}"

if ! command -v cloudflared >/dev/null 2>&1; then
  echo "cloudflared not found in PATH" >&2
  exit 127
fi

exec cloudflared tunnel --url "$target" --metrics "$metrics" --no-autoupdate
