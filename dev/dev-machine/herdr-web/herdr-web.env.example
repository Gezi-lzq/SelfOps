# Copy to ~/.config/selfops/herdr-web.env.
# This file contains secrets after installation and must not be committed.

# Local ttyd bind address. Keep this on localhost; ngrok exposes it.
HERDR_WEB_TTYD_HOST=127.0.0.1
HERDR_WEB_TTYD_PORT=7681
HERDR_WEB_TTYD_BASE_PATH=/terminal
HERDR_WEB_NGROK_TARGET_PORT=8780

# Optional ttyd frontend options for this terminal instance.
# HERDR_WEB_TTYD_FONT_SIZE=14
# HERDR_WEB_TTYD_LINE_HEIGHT=1.15
# HERDR_WEB_TTYD_SCROLLBACK=5000
# HERDR_WEB_TTYD_DISABLE_LEAVE_ALERT=true
# HERDR_WEB_TTYD_DISABLE_RESIZE_OVERLAY=true

# ttyd HTTP basic auth in user:password form.
# Leave empty only if ngrok or another proxy already enforces authentication.
HERDR_WEB_TTYD_CREDENTIAL=debian:change-me

# Herdr session opened by the browser terminal.
HERDR_WEB_SESSION=browser
HERDR_WEB_CWD=/home/debian

# Optional full command override. Leave empty for `herdr --session $HERDR_WEB_SESSION`.
# HERDR_WEB_COMMAND=

# Optional ngrok static endpoint, if the account has one.
# HERDR_WEB_NGROK_URL=https://example.ngrok-free.dev
# HERDR_WEB_NGROK_DOMAIN=

# Enable when ngrok reports ERR_NGROK_334 because this account's endpoint is
# already online elsewhere and you intentionally want pooled backends.
HERDR_WEB_NGROK_POOLING=false
