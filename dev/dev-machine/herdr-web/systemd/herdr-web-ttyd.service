[Unit]
Description=Herdr browser terminal via ttyd
After=network-online.target

[Service]
Type=simple
Environment=SELFOPS_ROOT=__SELFOPS_ROOT__
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/selfops/herdr-web.env
ExecStart=__SELFOPS_ROOT__/dev/dev-machine/herdr-web/bin/herdr-web-ttyd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
