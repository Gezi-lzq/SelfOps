[Unit]
Description=Cloudflare quick tunnel for Nowledge Mem (nmem)
After=network-online.target

[Service]
Type=simple
Environment=SELFOPS_ROOT=__SELFOPS_ROOT__
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/selfops/herdr-web.env
ExecStart=__SELFOPS_ROOT__/dev/dev-machine/herdr-web/bin/nmem-cloudflared
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
