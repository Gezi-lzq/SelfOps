{
	auto_https off
}

:8780 {
	bind 127.0.0.1

	# Public path router exposed by ngrok. Add specific routes above the fallback.
	handle /herdr/terminal-mobile* {
		uri strip_prefix /herdr
		reverse_proxy 127.0.0.1:7682
	}

	handle /herdr/terminal* {
		uri strip_prefix /herdr
		reverse_proxy 127.0.0.1:7681
	}

	handle /herdr/history* {
		uri strip_prefix /herdr
		reverse_proxy 127.0.0.1:8765
	}

	handle /herdr/api.json {
		uri strip_prefix /herdr
		reverse_proxy 127.0.0.1:8765
	}

	handle /herdr/touch-terminal* {
		root * public
		file_server
	}

	handle /terminal-mobile* {
		reverse_proxy 127.0.0.1:7682
	}

	handle /terminal* {
		reverse_proxy 127.0.0.1:7681
	}

	handle /history* {
		reverse_proxy 127.0.0.1:8765
	}

	handle /api.json {
		reverse_proxy 127.0.0.1:8765
	}

	handle /kiro-gateway {
		rewrite * /
		reverse_proxy 127.0.0.1:8000
	}

	handle /kiro-gateway/* {
		uri strip_prefix /kiro-gateway
		reverse_proxy 127.0.0.1:8000
	}

	handle /herdr {
		rewrite * /
		reverse_proxy 127.0.0.1:8765
	}

	handle /herdr/* {
		uri strip_prefix /herdr
		reverse_proxy 127.0.0.1:8765
	}

	@root path /
	handle @root {
		rewrite * /index.html
		root * public
		file_server
	}

	handle {
		respond "Not found" 404
	}
}
