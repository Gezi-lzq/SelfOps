[Unit]
Description=Mount gezi-dev cloud storage via rclone
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/rclone/rclone.conf
ConditionPathIsDirectory=%h/Drive

[Service]
Type=notify
ExecStart=%h/.local/share/mise/shims/rclone mount gdrive:gezi-dev %h/Drive \
  --config=%h/.config/rclone/rclone.conf \
  --cache-dir=/data/scratch/rclone-cache/gdrive \
  --vfs-cache-mode=writes \
  --vfs-cache-max-size=20G \
  --vfs-cache-max-age=24h \
  --dir-cache-time=10m \
  --poll-interval=5m \
  --umask=077
ExecStop=/usr/bin/fusermount3 -u %h/Drive
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
